# Job Service runtime values. Supply real values through the runtime secret mechanism.
ConnectionStrings__default=Server=<mysql-host>;Port=3306;Database=jobdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;
Cors__AllowedOrigins__0=http://localhost:5173
CustomerService__BaseUrl=http://<customer-service-host>:5037
# Must match InternalServiceAuthentication__Key in Customer & Asset Service.
CustomerService__InternalServiceKey=<shared-internal-service-key-at-least-32-bytes>
Kafka__BootstrapServers=<kafka-host>:9092
# Must be identical in Customer & Asset, Dispatch, Job and Reporting.
Authentication__Jwt__Issuer=assms-customer-asset-service
Authentication__Jwt__Audience=assms-internal
Authentication__Jwt__SigningKey=<shared-jwt-signing-key-at-least-32-bytes>
